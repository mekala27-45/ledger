# Copy to .env for local runs. Nothing here is required for the static site.
LEDGER_TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/ledger_test
DATABASE_URL=postgresql+psycopg://user:password@host/ledger
LEDGER_ID_SALT=replace-with-a-long-random-string-per-deployment
LEDGER_API_TOKEN=replace-with-a-demo-token
LEDGER_ENV=development
# Optional: a FRED key for the optional macro fetch path. Nothing from FRED is committed.
FRED_API_KEY=
