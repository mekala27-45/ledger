# The ledger API: scoring, the desk's replay stream, alerts, cases and audit.
# Build after `make models` so results/models holds the fraud model and the replay stream;
# without them the API still starts and those endpoints answer 503.
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN pip install --no-cache-dir "uv>=0.8,<0.9" && apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY packages ./packages
RUN uv sync --frozen --no-dev --no-default-groups --package ledger-api
COPY config ./config
COPY rules ./rules
COPY results/models ./results/models
ENV LEDGER_ROOT=/app PORT=8080 PATH="/app/.venv/bin:$PATH"
EXPOSE 8080
CMD ["sh", "-c", "cd packages/api && alembic upgrade head && cd /app && uvicorn ledger_api.main:app --host 0.0.0.0 --port ${PORT}"]
