# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
dist/
build/

# Data: raw and staged inputs are rebuilt by `make fetch` and `make generate`
data/raw/*
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep
data/staged/*
!data/staged/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
.cache/

# Warehouse build output
warehouse/target/
warehouse/dbt_packages/
warehouse/logs/
warehouse/*.duckdb
warehouse/*.duckdb.wal
logs/

# Model binaries are rebuilt; the registry metadata is committed
results/models/**/*.pkl
results/models/**/*.joblib
results/models/**/*.txt
# The served card fraud model is committed so the API image and its tests build from the repository.
!results/models/fraud_card/model.txt
# Row level scored outputs are rebuilt by `make models`; aggregates are committed
results/models/**/applications_scored.parquet

# Web
web/node_modules/
web/.next/
web/out/
web/test-results/
web/playwright-report/
web/tsconfig.tsbuildinfo

# Local environment
.env
*.log
.DS_Store
warehouse/.user.yml
results/models/**/scored_stream.parquet
results/models/**/replay_stream.parquet
results/models/**/replay_history.parquet
# The desk's replay is committed so the API image builds from the repository; it is rebuilt from the
# committed model by scripts/build_replay.py, never by retraining (see DECISIONS.md, 2026-10-28).
!results/models/fraud_card/replay_stream.parquet
!results/models/fraud_card/replay_history.parquet

# Deploy: the token and the live address stay on the machine that verifies the deploy.
deploy/write-token.txt
deploy/live-url.txt
deploy/verify-log.txt
